{
  "name": "bookora-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "postinstall": "patch-package",
    "gen:api": "orval --config ./orval.config.ts && node ./scripts/fix-orval-vue-weak-body.mjs && npm run verify:generated-zod",
    "gen:api:client": "orval --config ./orval.config.ts --project bookora",
    "gen:api:zod": "orval --config ./orval.config.ts --project bookoraZod",
    "openapi:sync": "node ./scripts/sync-openapi.mjs",
    "gen:api:local": "npm run openapi:sync && npm run gen:api",
    "verify:generated-zod": "node ./scripts/verify-generated-zod.mjs",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@lucide/vue": "^1.17.0",
    "@radix-icons/vue": "^1.0.0",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/vue-query": "^5.100.10",
    "@tanstack/vue-table": "^8.21.3",
    "@tiptap/extension-character-count": "^3.28.0",
    "@tiptap/extension-link": "^3.28.0",
    "@tiptap/extension-placeholder": "^3.28.0",
    "@tiptap/extension-text-align": "^3.28.0",
    "@tiptap/extension-underline": "^3.28.0",
    "@tiptap/starter-kit": "^3.28.0",
    "@tiptap/vue-3": "^3.28.0",
    "@unovis/vue": "^1.6.7",
    "@vietmap/vietmap-gl-js": "^7.0.0-pre.1",
    "@vueuse/core": "^14.3.0",
    "axios": "^1.16.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-vue": "^8.6.0",
    "pinia": "^3.0.4",
    "reka-ui": "^2.9.10",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "vee-validate": "^4.15.1",
    "vercel": "^58.9.1",
    "vue": "^3.5.34",
    "vue-draggable-plus": "^0.6.1",
    "vue-easy-lightbox": "^1.19.0",
    "vue-router": "^5.0.7",
    "vue-sonner": "^2.0.9",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.12.3",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "happy-dom": "^20.10.2",
    "orval": "8.17.0",
    "patch-package": "8.0.1",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.8",
    "vue-tsc": "^3.2.8"
  }
}
